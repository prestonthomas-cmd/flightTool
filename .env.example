# Copy to .env and fill in. Real environment variables always win over this
# file, so the same repo works locally, on a server, and in CI secrets.

# --- Email ------------------------------------------------------------------
# Where the digest is sent. Several addresses can be comma-separated.
EMAIL_TO=you@example.com
EMAIL_FROM=Flight tracker <you@example.com>

# --- SMTP -------------------------------------------------------------------
# starttls (port 587, the usual), ssl (port 465), or none.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=you@example.com

# Gmail needs an app password, not your account password: it requires 2-step
# verification, then myaccount.google.com/apppasswords. SendGrid and Mailgun
# work the same way with their own SMTP credentials.
SMTP_PASSWORD=
