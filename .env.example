# Copy to .env and fill in. Real environment variables always win over this
# file, so the same repo works locally, on a server, and in CI secrets.

# --- Email ------------------------------------------------------------------
# Where the digest is sent. Several addresses can be comma-separated.
EMAIL_TO=you@example.com
EMAIL_FROM=Flight tracker <you@example.com>

# --- SMTP -------------------------------------------------------------------
# starttls (port 587, the usual), ssl (port 465), or none.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=you@example.com

# Gmail needs an app password, not your account password: it requires 2-step
# verification, then myaccount.google.com/apppasswords. SendGrid and Mailgun
# work the same way with their own SMTP credentials.
SMTP_PASSWORD=

# --- Backfilling price history (optional) -----------------------------------
# A new watch needs ~20 runs before its statistics mean anything. Google already
# knows what the flight has cost for the past couple of months, but that data is
# not in the page this tool scrapes — verified against a live search, which
# returns no price series at all. SearchAPI is a paid Google Flights proxy that
# does return it, and `fast-flights` already integrates with it.
#
# This is one request per watch, not per run, so a handful of calls covers the
# whole watchlist once and is never needed again.
#
#   flighttracker backfill --dry-run   # see what would be imported
#   flighttracker backfill             # import it
SEARCHAPI_KEY=
