# Copy to .env.local and fill in. Never commit the filled-in file.

# Supabase > Project Settings > API. Both are safe in the browser: the anon
# key only ever grants what row-level security allows.
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase > Project Settings > API > service_role. This bypasses row-level
# security entirely and must never reach the browser: it is read only by the
# /api/sync route, server side. Treat it like a database password.
SUPABASE_SERVICE_ROLE_KEY=

# A long random string you invent. The scraper sends it to prove it is the
# scraper; without it /api/sync refuses every request rather than defaulting
# to open. Generate one with:  openssl rand -hex 32
SYNC_SECRET=
