# Your credentials stay out of git.
.env
.env.*
!.env.example

# `watches.yaml` IS committed: the scheduled GitHub Action needs it in the repo,
# and so does the price database it appends to. Keep the repo private if your
# travel plans are not public. Nothing secret belongs in either file.

__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.DS_Store

# The dashboard is rebuilt from the database on every run; the workflow commits
# it so a private repo carries a readable copy.

# Built fresh by the publish workflow; the committed dashboard is index.html.
site/
